# Copy to .env — never commit .env
DATABASE_URL="file:./dev.db"

# Signs the demo session cookie. Set a long random value outside local demos.
SESSION_SECRET=""

# --- AI summaries (all optional: without any key the built-in deterministic summariser is used) ---
# AI_PROVIDER: "auto" (default) | "bedrock" | "openai" | "deterministic"
AI_PROVIDER="auto"

# Amazon Bedrock (preferred). Uses a Bedrock API key (bearer token) against the Converse API.
AWS_BEARER_TOKEN_BEDROCK=""
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID=""

# OpenAI (fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Smartwatch / phone sync (optional; see docs/WEARABLES.md) ---
# Only vitals measured within this many minutes can raise limit alerts (older synced data is stored only).
WEARABLE_ALERT_WINDOW_MIN="60"
# Minutes without a sync before a linked watch raises a "Wearable sync" alert.
WEARABLE_SYNC_STALE_MIN="360"

# --- Emergency transfer (see docs/EMERGENCY-TRANSFER.md) ---
# Emergency number shown to patients and caregivers (Oman 9999; e.g. 999 / 911 / 112 elsewhere).
EMERGENCY_NUMBER="9999"
AMBULANCE_SERVICE_NAME="Ambulance service (simulated)"
RECEIVING_HOSPITAL_NAME="City General Hospital (simulated)"
# Demo clock for the simulated ambulance/hospital: 0.1 = 10x faster than a real call-out, 1 = real time.
TRANSFER_TIME_SCALE="0.1"

# --- Monitoring rules ---
# Heart-failure weight trend: alert when weight rises by this many kg within 72 h (demo setting).
WEIGHT_GAIN_ALERT_KG="2"

# --- Safety ---
# Set to "false" in ANY environment that may hold real patient data: disables the simulator,
# data reset, synthetic wearable syncs and the transfer demo clock.
DEMO_MODE="true"
