{
  "name": "remote-inpatient-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Remote Inpatient AI — hospital-at-home virtual ward (hackathon MVP, synthetic data only)",
  "scripts": {
    "predev": "prisma db push --skip-generate",
    "dev": "next dev -p 3210",
    "build": "prisma generate && next build",
    "prestart": "prisma db push --skip-generate",
    "start": "next start -p 3210",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
